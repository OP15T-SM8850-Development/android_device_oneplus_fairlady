# Run after vendor post-boot setup. The service loads controls after boot completed.
on property:sys.boot_completed=1
    chown system system /sys/devices/system/cpu/cpufreq/policy0/scaling_min_freq
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy0/scaling_min_freq
    chown system system /sys/devices/system/cpu/cpufreq/policy0/scaling_max_freq
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy0/scaling_max_freq
    chown system system /sys/devices/system/cpu/cpufreq/policy0/scaling_governor
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy0/scaling_governor
    chown system system /sys/devices/system/cpu/cpufreq/policy1/scaling_min_freq
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy1/scaling_min_freq
    chown system system /sys/devices/system/cpu/cpufreq/policy1/scaling_max_freq
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy1/scaling_max_freq
    chown system system /sys/devices/system/cpu/cpufreq/policy1/scaling_governor
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy1/scaling_governor
    chown system system /sys/devices/system/cpu/cpufreq/policy2/scaling_min_freq
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy2/scaling_min_freq
    chown system system /sys/devices/system/cpu/cpufreq/policy2/scaling_max_freq
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy2/scaling_max_freq
    chown system system /sys/devices/system/cpu/cpufreq/policy2/scaling_governor
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy2/scaling_governor
    chown system system /sys/devices/system/cpu/cpufreq/policy3/scaling_min_freq
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy3/scaling_min_freq
    chown system system /sys/devices/system/cpu/cpufreq/policy3/scaling_max_freq
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy3/scaling_max_freq
    chown system system /sys/devices/system/cpu/cpufreq/policy3/scaling_governor
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy3/scaling_governor
    chown system system /sys/devices/system/cpu/cpufreq/policy4/scaling_min_freq
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy4/scaling_min_freq
    chown system system /sys/devices/system/cpu/cpufreq/policy4/scaling_max_freq
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy4/scaling_max_freq
    chown system system /sys/devices/system/cpu/cpufreq/policy4/scaling_governor
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy4/scaling_governor
    chown system system /sys/devices/system/cpu/cpufreq/policy5/scaling_min_freq
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy5/scaling_min_freq
    chown system system /sys/devices/system/cpu/cpufreq/policy5/scaling_max_freq
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy5/scaling_max_freq
    chown system system /sys/devices/system/cpu/cpufreq/policy5/scaling_governor
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy5/scaling_governor
    chown system system /sys/devices/system/cpu/cpufreq/policy6/scaling_min_freq
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy6/scaling_min_freq
    chown system system /sys/devices/system/cpu/cpufreq/policy6/scaling_max_freq
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy6/scaling_max_freq
    chown system system /sys/devices/system/cpu/cpufreq/policy6/scaling_governor
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy6/scaling_governor
    chown system system /sys/devices/system/cpu/cpufreq/policy7/scaling_min_freq
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy7/scaling_min_freq
    chown system system /sys/devices/system/cpu/cpufreq/policy7/scaling_max_freq
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy7/scaling_max_freq
    chown system system /sys/devices/system/cpu/cpufreq/policy7/scaling_governor
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy7/scaling_governor
    chown system system /sys/devices/platform/soc/3d00000.qcom,kgsl-3d0/devfreq/3d00000.qcom,kgsl-3d0/min_freq
    chmod 0664 /sys/devices/platform/soc/3d00000.qcom,kgsl-3d0/devfreq/3d00000.qcom,kgsl-3d0/min_freq
    chown system system /sys/devices/platform/soc/3d00000.qcom,kgsl-3d0/devfreq/3d00000.qcom,kgsl-3d0/max_freq
    chmod 0664 /sys/devices/platform/soc/3d00000.qcom,kgsl-3d0/devfreq/3d00000.qcom,kgsl-3d0/max_freq
